# ============================================================
#                    ArcleFX App — ENV VARS
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Circle Kit Key (get from console.circle.com → App Kit)
VITE_CIRCLE_KIT_KEY=your_kit_key_here

# WalletConnect Project ID (get a FREE one at cloud.walletconnect.com)
# Without this, the WalletConnect button will show "Needs config"
VITE_WC_PROJECT_ID=your_walletconnect_project_id_here

# Alchemy API Key — used as ERC-4337 bundler for Circle Paymaster gasless flow.
# Get a free key at dashboard.alchemy.com → Create App → select network.
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# ArcleFXCore contract address (Arbitrum One — primary mainnet)
VITE_CONTRACT_ADDRESS=0xYOUR_ARCLE_FX_CORE_MAINNET_ADDRESS

# Per-network contract addresses (mainnet)
VITE_CONTRACT_ADDRESS_ETH=0xYOUR_ARCLE_FX_CORE_MAINNET_ADDRESS
VITE_CONTRACT_ADDRESS_ARB=0xYOUR_ARCLE_FX_CORE_MAINNET_ADDRESS
VITE_CONTRACT_ADDRESS_BASE=0xYOUR_ARCLE_FX_CORE_MAINNET_ADDRESS
VITE_CONTRACT_ADDRESS_ARC=0xYOUR_ARCLE_FX_CORE_MAINNET_ADDRESS

# ============================================================
#              Fee basis points (1 bps = 0.01%)
# ============================================================
VITE_BRIDGE_FEE_BPS=5
VITE_SWAP_FEE_BPS=30
VITE_UNIFIED_BALANCE_FEE_BPS=10
